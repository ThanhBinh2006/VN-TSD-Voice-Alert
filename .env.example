# ==============================================================================
# TSD-Voice-Alert — Cấu hình biến môi trường mẫu (.env.example)
# Sao chép file này thành `.env` ở thư mục gốc và điền thông tin của bạn:
#   cp .env.example .env
# Lưu ý: File `.env` đã được thêm vào `.gitignore` (KHÔNG commit lên Git).
# ==============================================================================

# --- 1. Cấu hình Kaggle CLI (Dùng cho tools/kaggle_push.py) ---
# Tên tài khoản Kaggle của bạn (bắt buộc khi đẩy/tải kernel qua CLI)
KAGGLE_USERNAME=your_kaggle_username

# API Key từ Kaggle (Account -> Settings -> API -> Create New Token)
KAGGLE_KEY=your_kaggle_api_key

# Dataset gắn kèm khi đẩy notebook lên Kaggle
# Có thể ghi dạng `<owner>/<dataset-slug>` hoặc chỉ `<dataset-slug>` (tự ghép với KAGGLE_USERNAME)
# Nếu gắn nhiều dataset, ngăn cách bằng dấu phẩy
KAGGLE_DATASET=tsd-voice-alert-preprocessed-data

# (Tuỳ chọn) Tên định danh (slug) của notebook trên Kaggle
# Để trống sẽ tự đặt theo pipeline: tsd-voice-alert-yolo26m hoặc tsd-voice-alert-faster_rcnn
KAGGLE_KERNEL_SLUG=

# --- 2. Cấu hình dữ liệu cục bộ (Tuỳ chọn) ---
# Đường dẫn thư mục dữ liệu mặc định cho phân tích EDA (analysis/eda.py)
DATA_ROOT=data/raw

# --- 3. Cấu hình Weights & Biases (Tuỳ chọn khi bật require_wandb) ---
WANDB_API_KEY=
WANDB_BASE_URL=

